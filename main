-- Scripts:

local function FATH_fake_script() -- LightningY.ButtonOpen 
	local script = Instance.new('LocalScript', LightningY)

	
	
	local button = script.Parent:WaitForChild("Dragicon"):WaitForChild("Openbutton")
	local gui = game.Players.LocalPlayer.PlayerGui:WaitForChild("Lightning Y"):WaitForChild("Mainthing")
	
	button.MouseButton1Click:Connect(function()
		gui.Visible = not gui.Visible
	end)
	
	
	
end
coroutine.wrap(FATH_fake_script)()
local function GZBTD_fake_script() -- LightningY.InsertOpen 
	local script = Instance.new('LocalScript', LightningY)

	local UserInputService = game:GetService("UserInputService")
	
	UserInputService.InputBegan:Connect(function(input, gameProcessed)
		if gameProcessed then return end
	
		if input.KeyCode == Enum.KeyCode.Insert then
			local gui = game.Players.LocalPlayer.PlayerGui:WaitForChild("Lightning Y"):WaitForChild("Mainthing")
			gui.Visible = not gui.Visible
		end
	end)
end
coroutine.wrap(GZBTD_fake_script)()
local function PJBTI_fake_script() -- Name_3.exec detection 
	local script = Instance.new('LocalScript', Name_3)

	local exec = identifyexecutor()
	script.Parent.Text = exec
	script.Parent.Parent.Parent.Parent.exec.Value = exec
end
coroutine.wrap(PJBTI_fake_script)()
local function WTOZE_fake_script() -- Dragicon.LocalScript 
	local script = Instance.new('LocalScript', Dragicon)

	local UserInputService = game:GetService("UserInputService")
	
	local gui = script.Parent
	
	local dragging
	local dragInput
	local dragStart
	local startPos
	
	local function update(input)
		local delta = input.Position - dragStart
		gui.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
	end
	
	gui.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			dragging = true
			dragStart = input.Position
			startPos = gui.Position
			
			input.Changed:Connect(function()
				if input.UserInputState == Enum.UserInputState.End then
					dragging = false
				end
			end)
		end
	end)
	
	gui.InputChanged:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
			dragInput = input
		end
	end)
	
	UserInputService.InputChanged:Connect(function(input)
		if input == dragInput and dragging then
			update(input)
		end
	end)
end
coroutine.wrap(WTOZE_fake_script)()
